<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Local AI Chat</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27><text y=%27.9em%27 font-size=%2790%27>🦙</text></svg>">
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: system-ui, sans-serif;
    background: #14161f; color: #e6e8ef;
    height: 100vh; display: flex; flex-direction: column;
  }
  header {
    padding: .8rem 1.2rem; display: flex; gap: 1rem; align-items: center;
    background: #1b1e2b; border-bottom: 1px solid #2a2e40;
  }
  header h1 { font-size: 1rem; font-weight: 600; flex: 1; }
  header select, header button {
    font: inherit; background: #262a3c; color: #e6e8ef;
    border: 1px solid #3a3f58; border-radius: 6px; padding: .35rem .7rem;
  }
  header span { color: #7f869c; font-size: .8rem; }
  #log { flex: 1; overflow-y: auto; padding: 1.2rem; display: flex; flex-direction: column; gap: .8rem; }
  .msg { max-width: 80%; padding: .6rem .9rem; border-radius: 10px; white-space: pre-wrap; line-height: 1.45; }
  .user   { align-self: flex-end; background: #2f5af0; color: #fff; }
  .bot    { align-self: flex-start; background: #232738; }
  .note   { align-self: center; color: #7f869c; font-size: .78rem; }
  footer { padding: .8rem; background: #1b1e2b; border-top: 1px solid #2a2e40; display: flex; gap: .5rem; }
  #prompt {
    flex: 1; font: inherit; padding: .55rem .8rem; border-radius: 8px;
    border: 1px solid #3a3f58; background: #14161f; color: #e6e8ef;
  }
  footer button {
    font: inherit; padding: .55rem 1.1rem; border: 0; border-radius: 8px;
    background: #2f5af0; color: #fff; cursor: pointer;
  }
  footer button:disabled { opacity: .5; cursor: wait; }
</style>
</head>
<body>
<header>
  <h1>🦙 Local AI Chat</h1>
  <span id="mods">loading modules…</span>
  <button id="clearBtn" title="Delete stored chat history (DB)">🗑 clear</button>
</header>
<div id="log"></div>
<footer>
  <select id="module"><option value="">no module</option></select>
  <input id="prompt" placeholder="Ask something… (e.g. add https://example.com to test a module)" autofocus>
  <button id="send">Send</button>
</footer>

<script>
// If the page itself is served over HTTPS, use the HTTPS API to stay
// mixed-content free; plain HTTP page falls back to the plain API.
// Same-origin API first (served proxied by serve_https.py -> no CORS, works
// on localhost AND LAN IP). Fallback: the API server directly.
const API_CANDIDATES = [
  "",                          // https://<this-host>:8443/me/chat  (proxied)
  "http://localhost:8000",     // api_server in plain http (local only)
];
let API = API_CANDIDATES[0];
const log = document.getElementById("log");
const promptInput = document.getElementById("prompt");
const sendBtn = document.getElementById("send");
const moduleSel = document.getElementById("module");
const modsSpan = document.getElementById("mods");

function add(cls, text) {
  const el = document.createElement("div");
  el.className = "msg " + cls;
  el.textContent = text;
  log.appendChild(el);
  log.scrollTop = log.scrollHeight;
}

async function pickApi() {
  for (const base of API_CANDIDATES) {
    try {
      const r = await fetch(base + "/modules", { signal: AbortSignal.timeout(4000) });
      if (r.ok) { API = base; return true; }
    } catch { /* try next */ }
  }
  API = API_CANDIDATES[0];
  return false;
}

async function loadModules() {
  const ok = await pickApi();
  if (!ok) { modsSpan.textContent = "could not reach API — start: python ai_server.py"; return; }
  try {
    const r = await fetch(API + "/modules");
    const data = await r.json();
    modsSpan.textContent = `api: ${API} · modules: ` + data.modules.join(", ") || "no modules";
    for (const m of data.modules) {
      const o = document.createElement("option");
      o.value = o.textContent = m;
      moduleSel.appendChild(o);
    }
  } catch { modsSpan.textContent = "could not load modules"; }
}

async function send() {
  const text = promptInput.value.trim();
  if (!text) return;
  add("user", text);
  promptInput.value = "";
  sendBtn.disabled = true;
  if (moduleSel.value) add("note", `running module: ${moduleSel.value}`);
  try {
    const r = await fetch(API + "/chat", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({
        message: text,
        module: moduleSel.value || null,
        max_new_tokens: 512,
      }),
    });
    const data = await r.json();
    if (data.response) add("bot", data.response);
    else add("note", "Error: " + JSON.stringify(data));
  } catch (e) {
    add("note", "Request failed — start the API with:  python ai_server.py");
  }
  sendBtn.disabled = false;
  promptInput.focus();
}

async function loadHistory() {
  try {
    const r = await fetch(API + "/history");
    const data = await r.json();
    if (data.messages && data.messages.length) {
      for (const m of data.messages) {
        if (m.role === "user") {
          if (m.module) add("note", `[saved] ran module: ${m.module}`);
          add("user", m.content);
        } else if (m.role === "assistant") {
          add("bot", m.content);
        }
      }
      add("note", `restored ${data.messages.length} stored message(s) from chat_history.db`);
    }
  } catch { /* history optional */ }
}

document.getElementById("clearBtn").addEventListener("click", async () => {
  try {
    await fetch(API + "/history", { method: "DELETE" });
    log.innerHTML = "";
    add("note", "history cleared (both this page and chat_history.db)");
  } catch (e) {
    add("note", "could not clear history: " + e);
  }
});

sendBtn.addEventListener("click", send);
promptInput.addEventListener("keydown", e => { if (e.key === "Enter") send(); });
loadModules().then(loadHistory);
</script>
</body>
</html>
