{
  "project": {
    "name": "mystatic",
    "version": "1.2.0",
    "description": "Local AI Chat Server with pluggable modules, skills, and tool-calling agent"
  },
  "server": {
    "host": "0.0.0.0",
    "api_port": 8000,
    "api_ssl_port": 8444,
    "web_port": 8443,
    "ssl": {
      "enabled": true,
      "cert_file": "server.crt",
      "key_file": "server.key"
    }
  },
  "ai": {
    "backend": "auto",
    "ollama": {
      "url": "http://localhost:11434",
      "model": "llama3.2:3b",
      "options": {
        "num_predict": 512,
        "temperature": 0.7,
        "num_ctx": 4096
      }
    },
    "transformers": {
      "model": "meta-llama/Meta-Llama-3-8B-Instruct"
    }
  },
  "agent": {
    "max_tool_steps": 8,
    "tool_timeout_seconds": 60,
    "max_file_read_bytes": 6000,
    "max_tool_output_bytes": 4000,
    "enable_tools_default": true
  },
  "history": {
    "db_file": "history.db",
    "max_query_limit": 1000,
    "default_query_limit": 500
  },
  "paths": {
    "modules_dir": "modules",
    "skills_dir": "skills",
    "scripts_dir": "scripts",
    "web_dir": "www"
  },
  "cors": {
    "allowed_origins": [
      "https://localhost:8443",
      "http://localhost:8443",
      "https://127.0.0.1:8443",
      "http://127.0.0.1:8443"
    ]
  }
}
